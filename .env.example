# Public API base (Node backend). Used by web now and later by mobile apps.
# Local:
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Vercel example:
# NEXT_PUBLIC_API_URL=https://your-api.vercel.app/api/v1


# Optional — only if you call Supabase directly from the browser later.
# Prefer the Node API for auth and data so mobile can reuse the same endpoints.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
